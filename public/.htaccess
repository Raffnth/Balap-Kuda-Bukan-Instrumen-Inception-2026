# Konfigurasi server SonarID untuk hosting Apache/LiteSpeed (cPanel) di sonarid.my.id.
# Berkas ini ikut tersalin ke folder dist saat "npm run build". Penjelasan lengkap: SECURITY.md.

DirectoryIndex index.html
Options -Indexes
ServerSignature Off

# 1) Paksa HTTPS dan hilangkan "www". Kamera di browser hanya boleh dibuka melalui HTTPS.
#    Jalur /.well-known dikecualikan agar perpanjangan sertifikat SSL (AutoSSL) tetap berjalan.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 2) Tolak berkas yang tidak boleh terbuka publik: berkas tersembunyi (.git, .env, .htaccess),
  #    peta kode sumber, cadangan, dan berkas konfigurasi proyek.
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(map|bak|old|orig|swp|log|sql|env|ini|sh|zip|tar|7z)$ - [F,L,NC]
  RewriteRule (^|/)(package(-lock)?\.json|vite\.config\.js|README\.md|SECURITY\.md|CHANGELOG\.md)$ - [F,L,NC]
</IfModule>

# 3) Batasi metode HTTP: situs ini statis, hanya perlu GET/HEAD/OPTIONS.
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|OPTIONS)$
  RewriteRule ^ - [F,L]
</IfModule>

# 4) Jenis berkas yang benar.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js .mjs
  AddType application/wasm .wasm
  AddType image/svg+xml .svg
  AddType audio/mpeg .mp3
  AddType application/octet-stream .task .traineddata
</IfModule>

# 5) Header keamanan.
<IfModule mod_headers.c>
  # Hanya HTTPS selama 1 tahun (subdomain cPanel tidak ikut diwajibkan).
  Header always set Strict-Transport-Security "max-age=31536000"
  # Kebijakan Keamanan Konten (CSP): skrip hanya dari situs sendiri dan CDN cadangan komponen AI,
  # tanpa plugin, tanpa iframe dari situs lain, dan formulir hanya ke situs sendiri.
  # 'wasm-unsafe-eval' dan 'unsafe-eval' dibutuhkan WebAssembly MediaPipe dan Tesseract (Emscripten).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval' https://cdn.jsdelivr.net; worker-src 'self' blob:; connect-src 'self' https://cdn.jsdelivr.net https://storage.googleapis.com data: blob:; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; style-src 'self' 'unsafe-inline'; font-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  # Kamera hanya untuk situs ini; mikrofon, lokasi, pembayaran, dan USB dimatikan.
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # 6) Cache: halaman, service worker, dan daftar berkas selalu diperiksa ulang agar versi baru
  #    langsung dipakai; berkas build bernama hash dan rekaman suara boleh disimpan lama.
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^(sw\.js|manifest\.json|vendor\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_]{8,}\.(js|css|mp3)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(wasm|task|traineddata\.gz)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# 7) Kompresi agar halaman lebih cepat terbuka di jaringan seluler.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml application/wasm
</IfModule>
