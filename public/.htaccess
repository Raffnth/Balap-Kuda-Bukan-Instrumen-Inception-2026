# Konfigurasi server SonarID untuk hosting Apache/LiteSpeed (cPanel) di sonarid.my.id.
# Berkas ini ikut tersalin ke folder dist saat "npm run build".

DirectoryIndex index.html
Options -Indexes

# 1) Paksa HTTPS dan hilangkan "www". Kamera di browser hanya boleh dibuka melalui HTTPS.
#    Jalur /.well-known dikecualikan agar perpanjangan sertifikat SSL (AutoSSL) tetap berjalan.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# 2) Jenis berkas yang benar.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js .mjs
  AddType application/wasm .wasm
  AddType image/svg+xml .svg
</IfModule>

# 3) Header keamanan: kamera hanya untuk situs ini; mikrofon, lokasi, dan pembayaran dimatikan.
<IfModule mod_headers.c>
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"

  # 4) Cache: halaman dan service worker selalu diperiksa ulang agar versi baru langsung dipakai;
  #    berkas build bernama hash (misalnya index-AbC123xy.js) boleh disimpan lama.
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# 5) Kompresi agar halaman lebih cepat terbuka di jaringan seluler.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
